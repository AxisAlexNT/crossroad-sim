{
  "name": "crossroad-sim",
  "private": true,
  "version": "0.1.0",
  "description": "Интерактивная модель перекрёстка Оборонной и Тверской улиц в Колпино: фазы, полосы, симуляция, подбор длительностей",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "build": "vite build",
    "build:check": "vue-tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "test:engine": "tsx scripts/engine-smoke.ts",
    "test:opt": "tsx scripts/opt-smoke.ts",
    "test:stall": "tsx scripts/stall-test.ts",
    "licenses": "node scripts/licenses.mjs",
    "osm": "tsx scripts/prepare-osm.ts",
    "check:dist": "node scripts/check-dist.mjs",
    "test": "npm run typecheck && npm run test:engine && npm run test:opt"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/language": "^6.11.0",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.0",
    "@fontsource/inter": "^5.2.5",
    "@jitl/quickjs-wasmfile-release-sync": "^0.32.0",
    "codemirror": "^6.0.2",
    "dejavu-fonts-ttf": "^2.37.3",
    "fflate": "^0.8.3",
    "jspdf": "^4.2.1",
    "quickjs-emscripten-core": "^0.32.0",
    "sucrase": "^3.35.0",
    "svg2pdf.js": "^2.5.0",
    "uplot": "^1.6.32",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "acorn": "^8.19.0",
    "tsx": "^4.19.2",
    "typescript": "~5.7.2",
    "vite": "^6.0.7",
    "vite-plugin-singlefile": "^2.1.0",
    "vue-tsc": "^3.3.14"
  }
}
